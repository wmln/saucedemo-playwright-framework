# Copy this file before running:
#   cp .env.example .env.local
#
# TEST_ENV defaults to "local", and the loader reads .env.<TEST_ENV> first,
# so .env.local is the file that gets picked up by default.
#
# These saucedemo credentials are printed on the login page itself, so they are
# committed here deliberately to make the repo clone-and-run. On a real client
# project these values are secrets: keep .env.example filled with placeholders
# only, and supply the real ones via .env.local locally and GitHub Secrets in CI.

TEST_USER=standard_user
TEST_PASSWORD=secret_sauce
LOCKED_OUT_USER=locked_out_user
